# Proxy API calls to the FastAPI backend (Netlify).
# Replace the URL below with your deployed backend URL, e.g.
#   /api/*  https://your-backend.onrender.com/api/:splat  200
# If the backend serves the frontend itself (same origin), this line is ignored.
/api/*  https://YOUR_BACKEND_URL/api/:splat  200

# SPA fallback
/*    /index.html   200
